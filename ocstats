def compare_window(spec: str, now: datetime, anchor_hi: int | None = None) -> tuple[int, int]:
    """Resolve one --compare window spec to (lo_ms, hi_ms).

    Relative specs (7d) end at `now`, or at `anchor_hi` when chaining the
    previous window directly before the current one.  Absolute specs
    (2026-09-01, 2026-09) are calendar ranges.
    """
    m = re.fullmatch(r"(\d+)([dwm])", spec.strip().lower())
    if m:
        n, unit = int(m.group(1)), m.group(2)
        span = {"d": timedelta(days=n), "w": timedelta(weeks=n),
                "m": timedelta(days=30 * n)}[unit]
        hi_dt = datetime.fromtimestamp(anchor_hi / 1000) if anchor_hi is not None else now
        lo_dt = hi_dt - span
        return int(lo_dt.timestamp() * 1000), int(hi_dt.timestamp() * 1000)
    try:
        lo = Filters._parse_when(spec, now, past=True)
        hi = Filters._parse_when(spec, now, past=False)
    except SystemExit as e:
        raise ValueError(str(e)) from e
    return int(lo.timestamp() * 1000), int(hi.timestamp() * 1000)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # --help/-h with no command → show the top-level help (command list + examples)
    if not any(a in COMMANDS for a in argv) and any(a in ("-h", "--help") for a in argv):
        if "-h" in argv or "--help" in argv:
            build_parser().print_help()
            return
    # allow global flags before/after the subcommand: relocate the command token
    cmd_idx = next((i for i, a in enumerate(argv) if a in COMMANDS), None)
    if cmd_idx is not None:
        argv = [argv[cmd_idx]] + argv[:cmd_idx] + argv[cmd_idx + 1:]
    elif not argv:
        argv = ["summary"]
    elif argv[0].startswith("-"):
        argv = ["summary"] + argv
    else:
        sys.exit(f"{PROG}: unknown command '{argv[0]}' "
                 f"(choose from: {', '.join(sorted(COMMANDS))})")

    args = build_parser().parse_args(argv)
    for key, val in DEFAULTS.items():
        if not hasattr(args, key):
            setattr(args, key, val)

    global MD_OUT
    MD_OUT = args.md and not args.json and not args.csv
    C.enabled = (not args.no_color and not os.environ.get("NO_COLOR")
                 and not args.json and not args.csv and not args.md
                 and sys.stdout.isatty())

    flt = Filters(args)
    if args.compare:
        if args.since or args.until:
            print(f"{PROG}: note: --since/--until ignored while --compare is active",
                  file=sys.stderr)
        cur, prev_spec = args.compare.split("/", 1) if "/" in args.compare \
            else (args.compare, args.compare)
        now = datetime.now()
        try:
            args._cur_window = compare_window(cur, now)
            args._prev_window = compare_window(prev_spec, now,
                                               anchor_hi=args._cur_window[0])
        except ValueError as e:
            sys.exit(f"{PROG}: bad --compare value '{args.compare}': {e}")
        flt.lo, flt.hi = args._cur_window
    if args.monthly_budget is not None and args.monthly_budget <= 0:
        sys.exit(f"{PROG}: --monthly-budget must be > 0")

    pricing = Pricing(refresh=getattr(args, "refresh", False))

    if args.command == "prices":
        conn = open_db(db_path(args))
        rows = flt.apply(fetch_rows(conn, flt))
        cmd_prices(rows, flt, pricing, args)
        return

    conn = open_db(db_path(args))
    rows = flt.apply(fetch_rows(conn, flt))
    args.prompt_rows = attribute_prompts(fetch_prompts(conn, flt), rows)
    args.prev = None
    if args.compare:
        plo, phi = args._prev_window
        pflt = Filters(args)
        pflt.lo, pflt.hi = plo, phi
        p_rows = pflt.apply(fetch_rows(conn, pflt))
        p_prompts = attribute_prompts(fetch_prompts(conn, pflt), p_rows)
        args.prev = (p_rows, p_prompts)
        if not p_rows:
            print(f"{PROG}: note: no usage found in the previous comparison window",
                  file=sys.stderr)

    if args.command == "summary":
        cmd_summary(rows, flt, pricing, args)
    elif args.command == "models":
        group_report(rows, flt, pricing, args, ["provider", "model"], "Usage by model")
    elif args.command == "providers":
        group_report(rows, flt, pricing, args, ["provider"], "Usage by provider")
    elif args.command == "agents":
        group_report(rows, flt, pricing, args, ["agent"], "Usage by agent")
    elif args.command == "projects":
        group_report(rows, flt, pricing, args, ["project"], "Usage by project")
    elif args.command == "sessions":
        cmd_sessions(rows, flt, pricing, args)
    elif args.command in ("daily", "weekly", "monthly"):
        dim = {"daily": "day", "weekly": "week", "monthly": "month"}[args.command]
        cmd_time_series(rows, flt, pricing, args, dim, args.command)
    elif args.command == "pivot":
        cmd_pivot(rows, flt, pricing, args)
    elif args.command == "matrix":
        dims = [DIM_ALIASES.get(d.strip(), d.strip())
                for d in args.by.split(",") if d.strip()]
        bad = [d for d in dims if d not in DIMENSIONS]
        if bad:
            sys.exit(f"{PROG}: unknown dimension(s) {bad} "
                     f"(choose from: {', '.join(DIMENSIONS)})")
        if not dims:
            sys.exit(f"{PROG}: --by needs at least one dimension")
        title = "Matrix by " + " × ".join(dims)
        group_report(rows, flt, pricing, args, dims, title)


if __name__ == "__main__":
    main()

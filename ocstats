class C:
    """ANSI color helper; all methods return '' when disabled."""
    enabled = False

    def _c(code: str, s: str) -> str:  # noqa: N805
        return f"\x1b[{code}m{s}\x1b[0m" if C.enabled else str(s)

    def bold(s): return C._c("1", s)
    def dim(s): return C._c("2", s)
    def red(s): return C._c("31", s)
    def green(s): return C._c("32", s)
    def yellow(s): return C._c("33", s)
    def blue(s): return C._c("34", s)
    def magenta(s): return C._c("35", s)
    def cyan(s): return C._c("36", s)
    def white(s): return C._c("37", s)


def money(v: float) -> str:
    """Adaptive currency: grouped 2dp for large, 3dp for $1+, 4dp for cents."""
    if v is None or (isinstance(v, float) and math.isnan(v)):
        return "—"
    if abs(v) >= 100:
        return f"${v:,.2f}"
    if abs(v) >= 1:
        return f"${v:.3f}"
    return f"${v:.4f}" if v else "$0"


def tok(v: int) -> str:
    return f"{v:,}" if v else "0"


def pct(v: float) -> str:
    return f"{v * 100:.1f}%" if v is not None else "—"



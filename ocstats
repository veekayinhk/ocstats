def term_width(args) -> int:
    if args.width:
        return max(60, min(args.width, 400))
    try:
        return max(60, min(shutil.get_terminal_size((110, 24)).columns, 400))
    except Exception:  # noqa: BLE001
        return 110


def disp_len(s: str) -> int:
    """Display width (CJK-safe enough; box chars are width 1)."""
    return len(s)


def truncate(s: str, width: int) -> str:
    if disp_len(s) <= width:
        return s
    return s[: width - 1] + "…"


class Table:
    """Boxed table with alignment, colors, totals and adaptive columns."""

    def __init__(self, title=None, width=110):
        self.title = title
        self.width = width
        self.cols = []       # (header, align, priority, color_fn)
        self.rows = []
        self.footer = None   # list of cells or None
        self.note = None

    def col(self, header, align="l", priority=0, color=None):
        self.cols.append([header, align, priority, color])
        return self

    def add(self, *cells):
        self.rows.append(list(cells))

    def set_footer(self, *cells):
        self.footer = list(cells)

    def render(self):
        headers = [c[0] for c in self.cols]
        aligns = [c[1] for c in self.cols]
        priorities = [c[2] for c in self.cols]
        color_fns = [c[3] for c in self.cols]

        if MD_OUT:
            return self.render_md(headers, aligns)
        return self.render_box(headers, aligns, priorities)

    def render_md(self, headers, aligns):
        """GitHub-flavored markdown pipe table (colors are globally off)."""
        def cells_of(row):
            out = []
            for i in range(len(headers)):
                cell = "" if i >= len(row) or row[i] is None else str(row[i])
                cell = cell.replace("|", "\\|").replace("\n", " ")
                out.append(cell.strip())
            return out

        def align_mark(i):
            a = aligns[i] if i < len(aligns) else "l"
            return "---:" if a == "r" else ":---:" if a == "c" else ":---"

        lines = []
        if self.title:
            lines.append(f"### {self.title}")
            lines.append("")
        lines.append("| " + " | ".join(headers) + " |")
        lines.append("| " + " | ".join(align_mark(i) for i in range(len(headers))) + " |")
        for row in self.rows:
            lines.append("| " + " | ".join(cells_of(row)) + " |")
        if self.footer:
            bold = lambda cs: [f"**{c.strip()}**" if c.strip() else "" for c in cs]  # noqa: E731
            lines.append("| " + " | ".join(bold(cells_of(self.footer))) + " |")
        if self.note:
            lines.append("")
            lines.append(f"*{self.note}*")
        return "\n".join(lines)

    def render_box(self, headers, aligns, priorities):

        # adaptive: drop lowest-priority columns until we fit
        def widths_for(count):
            idx = list(range(count))
            raw = []
            for i in idx:
                w = disp_len(headers[i])
                for row in self.rows + ([self.footer] if self.footer else []):
                    if i < len(row) and row[i] is not None:
                        w = max(w, disp_len(str(row[i])))
                raw.append(w)
            return idx, raw

        def total_w(idx, raw):
            return sum(raw[i] + 3 for i in idx) + 1

        keep = list(range(len(self.cols)))
        _, raw = widths_for(len(self.cols))
        while len(keep) > 2 and total_w(keep, raw) > self.width:
            victim = min(keep, key=lambda i: (priorities[i], -raw[i]))
            keep.remove(victim)
            raw[victim] = 0
        raw = [raw[i] if i in keep else 0 for i in range(len(self.cols))]

        def hline(left, mid, right, fill="─"):
            parts = [fill * (raw[i] + 2) for i in range(len(self.cols)) if i in keep]
            return left + mid.join(parts) + right

        def fmt_row(cells, *, bold=False, dim=False):
            out = []
            ki = 0
            for i, cell in enumerate(cells):
                if i not in keep:
                    continue
                s = "" if cell is None else str(cell)
                # strip ansi when measuring
                plain = re.sub(r"\x1b\[[0-9;]*m", "", s)
                pad = raw[i] - disp_len(plain)
                if aligns[i] == "r":
                    s = " " * pad + s
                elif aligns[i] == "c":
                    left = pad // 2
                    s = " " * left + s + " " * (pad - left)
                else:
                    s = s + " " * pad
                if bold:
                    s = C.bold(s)
                if dim:
                    s = C.dim(s)
                out.append(f" {s} ")
                ki += 1
            return BOX["v"] + BOX["v"].join(out) + BOX["v"]

        lines = []
        if self.title:
            lines.append(C.bold(C.cyan(self.title)))
        lines.append(hline(BOX["tl"], BOX["tm"], BOX["tr"]))
        lines.append(fmt_row(headers, bold=True))
        lines.append(hline(BOX["ml"], BOX["mm"], BOX["mr"]))
        for row in self.rows:
            cells = ["" if c is None else c for c in row]
            lines.append(fmt_row(cells))
        if self.footer:
            lines.append(hline(BOX["dtl"], BOX["dmm"], BOX["dtr"], fill="═"))
            lines.append(fmt_row(self.footer, bold=True))
        lines.append(hline(BOX["bl"], BOX["bm"], BOX["br"]))
        if self.note:
            lines.append(C.dim("  " + self.note))
        return "\n".join(lines)


def bar(frac: float, width: int = 10) -> str:
    frac = max(0.0, min(1.0, frac or 0.0))
    filled = round(frac * width)
    return C.cyan("█" * filled) + C.dim("░" * (width - filled))


def spark(vals: list[float]) -> str:
    if not vals:
        return ""
    mx = max(vals) or 1
    return "".join(SPARK_CHARS[min(7, int(v / mx * 8))] if v > 0 else
                   (SPARK_CHARS[0] if mx > 0 else "·") for v in vals)


def cost_cells(g, max_cost=None):
    """(rep, est, eff) formatted cells with color; '—' when pricing unknown."""
    rep = money(g["cost_rep"])
    no_price = (g["cost_est"] == 0 and g.get("tok_total", 0) > 0 and g["cost_rep"] == 0)
    est = "—" if no_price else money(g["cost_est"])
    eff = money(g["cost_eff"])
    return (C.dim(rep) if g["cost_rep"] == 0 else C.yellow(rep),
            C.dim(est) if no_price else C.green(est),
            C.bold(C.white(eff)))


def csv_write(title_rows: list[dict], dims: list[str]):
    """Emit groups as RFC-4180 CSV (raw numbers, full metric detail)."""
    w = csv.writer(sys.stdout, lineterminator="\n")
    cols = list(dims) + list(METRIC_KEYS)
    w.writerow(cols)
    for g in title_rows:
        w.writerow([g.get(c, "") for c in cols])


def budget_block(eff_mtd: float, budget: float, args) -> list[str]:
    """Month-end projection vs budget, rendered as text lines."""
    now = datetime.now()
    days_elapsed = now.day
    days_in_month = (now.replace(month=now.month % 12 + 1, day=1)
                     - timedelta(days=1)).day if now.month < 12 else 31
    projected = eff_mtd / days_elapsed * days_in_month if days_elapsed else 0.0
    used = eff_mtd / budget if budget else 0.0
    remaining = budget - eff_mtd
    verdict = ("UNDER PACE" if projected <= budget else "OVER PACE")
    vcolor = C.green if projected <= budget else C.red
    lines = []
    t = Table("Budget", width=term_width(args))
    t.col("Budget", "r").col("Spent (MTD)", "r").col("Projected", "r") \
     .col("Remaining", "r").col("Used", "r").col("Pace", "l")
    t.add(money(budget), C.white(money(eff_mtd)),
          C.yellow(money(projected)),
          (C.green if remaining >= 0 else C.red)(money(remaining)),
          pct(used), f"{bar(min(used, 1.0), 12)}  {vcolor(verdict)}")
    lines.append(t.render())
    lines.append("")
    return lines


def budget_json(eff_mtd: float, budget: float) -> dict:
    now = datetime.now()
    days_elapsed = now.day
    days_in_month = 31 if now.month == 12 else \
        (now.replace(month=now.month + 1, day=1) - timedelta(days=1)).day
    projected = eff_mtd / days_elapsed * days_in_month if days_elapsed else 0.0
    return {"budget": budget, "spent_mtd": eff_mtd, "projected_month_end": projected,
            "remaining": budget - eff_mtd,
            "used_pct": (eff_mtd / budget * 100) if budget else 0,
            "days_elapsed": days_elapsed, "days_in_month": days_in_month,
            "on_pace": projected <= budget}



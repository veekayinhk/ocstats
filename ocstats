def db_path(args) -> Path:
    p = Path(os.environ.get(DB_ENV, "") or DEFAULT_DB)
    return p


def open_db(path: Path) -> sqlite3.Connection:
    if not path.exists():
        sys.exit(f"{PROG}: database not found: {path}\n"
                 f"       set ${DB_ENV} to override the path.")
    uri = f"file:{path}?mode=ro"
    try:
        return sqlite3.connect(uri, uri=True)
    except sqlite3.OperationalError as e:
        sys.exit(f"{PROG}: cannot open database read-only ({path}): {e}")


QUERY = """
SELECT sm.session_id,
       sm.time_created,
       sm.data,
       sv.directory,
       sv.title,
       sv.slug
FROM session_message AS sm
LEFT JOIN session_v2 AS sv ON sv.id = sm.session_id
WHERE sm.type = 'assistant'
  AND sm.time_created >= ?
  AND sm.time_created <  ?
"""


def fetch_rows(conn: sqlite3.Connection, flt) -> list[dict]:
    """Return normalized usage records for assistant messages in [lo, hi)."""
    rows = []
    for session_id, ts, data, directory, title, slug in conn.execute(QUERY, (flt.lo, flt.hi)):
        try:
            d = json.loads(data)
        except (json.JSONDecodeError, TypeError):
            continue
        model = d.get("model") or {}
        toks = d.get("tokens") or {}
        cache = toks.get("cache") or {}
        dt = datetime.fromtimestamp(ts / 1000)
        rows.append({
            "ts": ts,
            "dt": dt,
            "day": dt.strftime("%Y-%m-%d"),
            "week": (dt - timedelta(days=dt.weekday())).strftime("%Y-%m-%d"),
            "month": dt.strftime("%Y-%m"),
            "provider": model.get("providerID") or "unknown",
            "model": model.get("id") or "unknown",
            "variant": model.get("variant") or "",
            "agent": d.get("agent") or "unknown",
            "session": session_id,
            "directory": directory or "",
            "project": (Path(directory).name if directory else "(none)"),
            "title": title or slug or "",
            "in": toks.get("input") or 0,
            "out": toks.get("output") or 0,
            "reason": toks.get("reasoning") or 0,
            "cr": cache.get("read") or 0,
            "cw": cache.get("write") or 0,
            "cost": d.get("cost") or 0.0,
        })
    return rows


PROMPT_QUERY = """
SELECT sm.session_id,
       sm.time_created,
       sm.data,
       sv.directory
FROM session_message AS sm
LEFT JOIN session_v2 AS sv ON sv.id = sm.session_id
WHERE sm.type = 'user'
  AND sm.time_created >= ? AND sm.time_created < ?
"""


def fetch_prompts(conn: sqlite3.Connection, flt) -> list[dict]:
    """One record per user prompt (message turn), normalized like usage rows."""
    out = []
    for session_id, ts, data, directory in conn.execute(PROMPT_QUERY, (flt.lo, flt.hi)):
        try:
            d = json.loads(data)
        except (json.JSONDecodeError, TypeError):
            continue
        model = d.get("model") or {}
        if flt.model and flt.model not in (model.get("id") or "").lower():
            continue
        if flt.provider and flt.provider not in (model.get("providerID") or "").lower():
            continue
        if flt.agent and flt.agent not in (d.get("agent") or "").lower():
            continue
        if flt.project:
            proj = (Path(directory).name if directory else "(none)").lower()
            if flt.project not in proj and flt.project not in (directory or "").lower():
                continue
        if flt.session and not session_id.startswith(flt.session):
            continue
        dt = datetime.fromtimestamp(ts / 1000)
        out.append({
            "ts": ts, "dt": dt,
            "day": dt.strftime("%Y-%m-%d"),
            "week": (dt - timedelta(days=dt.weekday())).strftime("%Y-%m-%d"),
            "month": dt.strftime("%Y-%m"),
            "provider": model.get("providerID") or "unknown",
            "model": model.get("id") or "unknown",
            "agent": d.get("agent") or "unknown",
            "session": session_id,
            "directory": directory or "",
            "project": (Path(directory).name if directory else "(none)"),
        })
    return out


def attribute_prompts(prompts: list[dict], rows: list[dict]) -> list[dict]:
    """User messages carry no model info — attribute each prompt to the
    assistant message that answers it (next in session, else previous)."""
    by_session = {}
    for r in sorted(rows, key=lambda r: r["ts"]):
        by_session.setdefault(r["session"], []).append(r)
    ts_index = {sid: [r["ts"] for r in msgs] for sid, msgs in by_session.items()}
    for p in prompts:
        msgs = by_session.get(p["session"])
        if not msgs:
            continue  # keep the prompt's own (mostly 'unknown') attributes
        idx = bisect.bisect_left(ts_index[p["session"]], p["ts"])
        ref = msgs[idx] if idx < len(msgs) else msgs[-1]
        p["provider"] = ref["provider"]
        p["model"] = ref["model"]
        p["agent"] = ref["agent"]
        p["directory"] = ref["directory"]
        p["project"] = ref["project"]
    return prompts



def apply_row_limits(groups, args, total_eff):
    """Apply --top/--bottom/--min-share (falls back to --limit)."""
    min_share = getattr(args, "min_share", 0) or 0
    hidden = 0
    if min_share > 0 and total_eff > 0:
        kept = [g for g in groups if g["cost_eff"] / total_eff * 100 >= min_share]
        hidden = len(groups) - len(kept)
        groups = kept
    limit = getattr(args, "top", 0) or getattr(args, "bottom", 0) or args.limit
    if limit and len(groups) > limit:
        return groups[:limit], len(groups) - limit, hidden
    return groups, 0, hidden


def group_report(rows, flt, pricing, args, dims, title, name_width=34):
    prompt_rows = getattr(args, "prompt_rows", None)
    sort_by = args.sort or ("date-desc" if args.command in
                            ("daily", "weekly", "monthly") else "cost")
    if args.top and args.bottom:
        sys.exit(f"{PROG}: --top and --bottom are mutually exclusive")
    groups = group_rows(rows, dims, pricing, prompt_rows)
    groups = sort_groups(groups, sort_by, dims)
    if args.bottom:  # bottom N = reverse of the requested sort order
        groups = list(reversed(groups))
    total_eff = sum(g["cost_eff"] for g in groups) or 1
    shown, rest_n, hid_n = apply_row_limits(groups, args, total_eff)
    rest = rest_n + hid_n

    if args.json:
        print(json.dumps({"meta": meta_json(flt, pricing),
                          "rows": [{k: g[k] for k in list(dims) + list(METRIC_KEYS)}
                                   for g in groups]}, indent=2))
        return

    if args.csv:
        csv_write(groups, dims)
        return

    print_hint_pricing(pricing)
    t = Table(title, width=term_width(args))
    for d in dims:
        t.col(d.capitalize(), "l", priority=10)
    metric_columns(t, details=getattr(args, "details", False),
                   metric=getattr(args, "metric", None))
    focus = METRIC_FOCUS.get(getattr(args, "metric", None)) if \
        getattr(args, "metric", None) else None

    # previous-period lookup for --compare deltas
    prev_map = {}
    prev = getattr(args, "prev", None)
    if prev:
        p_rows, p_prompts = prev
        for pg in group_rows(p_rows, dims, pricing, p_prompts):
            prev_map[tuple(pg[d] for d in dims)] = pg
    if prev_map:
        t.col("Prev Σ $", "r", priority=8).col("Δ Σ $", "r", priority=8) \
         .col("Δ msgs", "r", priority=6)

    for g in shown:
        cells = cost_cells(g)
        name_cells = [truncate(str(g[d]), name_width) for d in dims]
        row = [*name_cells]
        if focus:
            row.append(tok(focus(g)) if args.metric != "cost" else money(g["cost_eff"]))
        else:
            row += [tok(g["n"]), tok(g["sessions"]), tok(g["in"]), tok(g["out"]),
                    tok(g["cr"]), pct(g["cache_ratio"]), cells[0], cells[1], cells[2],
                    pct(g["cost_eff"] / total_eff)]
            if getattr(args, "details", False):
                row += [tok(g["prompts"]), tok(g["reason"]), tok(g["cw"]),
                        tok(round(g["tok_mean"])), tok(round(g["tok_median"])),
                        tok(round(g["tok_p90"])),
                        datetime.fromtimestamp(g["first_ts"] / 1000).strftime("%m-%d %H:%M"),
                        datetime.fromtimestamp(g["last_ts"] / 1000).strftime("%m-%d %H:%M")]
        if prev_map:
            pg = prev_map.get(tuple(g[d] for d in dims))
            if pg:
                d_eff = g["cost_eff"] - pg["cost_eff"]
                d_n = g["n"] - pg["n"]
                row += [C.dim(money(pg["cost_eff"])),
                        (C.green(money(d_eff)) if d_eff >= 0 else C.red(money(d_eff))),
                        (C.green(f"+{d_n}") if d_n >= 0 else C.red(str(d_n)))]
            else:
                row += [C.dim("—"), C.dim("new"), C.dim("+")]
        t.add(*row)
    if rest:
        rest_all = [g for g in groups if id(g) not in {id(s) for s in shown}]
        agg = {
            "n": sum(g["n"] for g in rest_all),
            "sessions": sum(g["sessions"] for g in rest_all),
            "in": sum(g["in"] for g in rest_all), "out": sum(g["out"] for g in rest_all),
            "cr": sum(g["cr"] for g in rest_all),
            "cost_rep": sum(g["cost_rep"] for g in rest_all),
            "cost_est": sum(g["cost_est"] for g in rest_all),
            "cost_eff": sum(g["cost_eff"] for g in rest_all),
            "cache_ratio": 0.0,
        }
        t.add(*([C.dim(f"+ {len(rest_all)} more")] + [C.dim("")] * (len(dims) - 1)),
              C.dim(tok(agg["n"])), C.dim(tok(agg["sessions"])),
              C.dim(tok(agg["in"])), C.dim(tok(agg["out"])), C.dim(tok(agg["cr"])),
              C.dim("—"), C.dim(money(agg["cost_rep"])),
              C.dim(money(agg["cost_est"])), C.dim(money(agg["cost_eff"])),
              C.dim(pct(agg["cost_eff"] / total_eff)))
    t.set_footer(*([C.bold("TOTAL")] + [""] * (len(dims) - 1)),
                 C.bold(tok(sum(g["n"] for g in groups))),
                 C.bold(tok(len({r["session"] for r in rows}))),
                 C.bold(tok(sum(g["in"] for g in groups))),
                 C.bold(tok(sum(g["out"] for g in groups))),
                 C.bold(tok(sum(g["cr"] for g in groups))),
                 C.bold(pct(sum(r["cr"] for r in rows) /
                            (sum(r["cr"] + r["in"] + r["cw"] for r in rows) or 1))),
                 C.bold(C.yellow(money(sum(g["cost_rep"] for g in groups)))),
                 C.bold(C.green(money(sum(g["cost_est"] for g in groups)))),
                 C.bold(C.white(money(sum(g["cost_eff"] for g in groups)))),
                 C.bold("100%"))
    t.note = "Σ = reported where > 0, else estimated · — = no pricing data available"
    if getattr(args, "min_share", 0):
        t.note += f" · {hid_n} group(s) below {args.min_share:g}% share hidden"
    print()
    print(t.render())
    print()



class Filters:
    def __init__(self, args):
        self.args = args
        self.lo, self.hi = self._range(args.since, args.until)
        self.model = (args.model or "").lower()
        self.provider = (args.provider or "").lower()
        self.agent = (args.agent or "").lower()
        self.project = (args.project or "").lower()
        self.session = args.session or ""

    @staticmethod
    def _range(since, until):
        now = datetime.now()
        lo_dt = datetime(1970, 1, 1)
        hi_dt = now + timedelta(days=1)
        if since:
            lo_dt = Filters._parse_when(since, now, past=True)
        if until:
            hi_dt = Filters._parse_when(until, now, past=False)
        return int(lo_dt.timestamp() * 1000), int(hi_dt.timestamp() * 1000)

    @staticmethod
    def _parse_when(s: str, now: datetime, past: bool) -> datetime:
        s = s.strip().lower()
        m = re.fullmatch(r"(\d+)([dwm])", s)
        if m:  # relative: 30d, 2w, 1m
            n, unit = int(m.group(1)), m.group(2)
            delta = {"d": timedelta(days=n), "w": timedelta(weeks=n),
                     "m": timedelta(days=30 * n)}[unit]
            return now - delta if past else now + delta
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", s):
            d = datetime.strptime(s, "%Y-%m-%d")
            return d if past else d + timedelta(days=1)
        if re.fullmatch(r"\d{4}-\d{2}", s):
            d = datetime.strptime(s, "%Y-%m")
            if past:
                return d
            # end of month
            if d.month == 12:
                nxt = d.replace(year=d.year + 1, month=1)
            else:
                nxt = d.replace(month=d.month + 1)
            return nxt
        if re.fullmatch(r"\d{4}", s):
            y = int(s)
            return datetime(y, 1, 1) if past else datetime(y + 1, 1, 1)
        sys.exit(f"{PROG}: cannot parse date '{s}' "
                 "(use YYYY-MM-DD, YYYY-MM, YYYY or e.g. 30d)")

    def apply(self, rows: list[dict]) -> list[dict]:
        out = []
        for r in rows:
            if self.model and self.model not in r["model"].lower():
                continue
            if self.provider and self.provider not in r["provider"].lower():
                continue
            if self.agent and self.agent not in r["agent"].lower():
                continue
            if self.project and (self.project not in r["project"].lower()
                                 and self.project not in r["directory"].lower()):
                continue
            if self.session and not r["session"].startswith(self.session):
                continue
            out.append(r)
        return out

    def describe(self) -> str:
        bits = []
        if self.args.since:
            bits.append(f"since {self.args.since}")
        if self.args.until:
            bits.append(f"until {self.args.until}")
        for label, val in (("model", self.model), ("provider", self.provider),
                           ("agent", self.agent), ("project", self.project)):
            if val:
                bits.append(f"{label}~{val}")
        if self.session:
            bits.append(f"session {self.session}")
        return ", ".join(bits) if bits else "all time"



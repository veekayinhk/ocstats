def group_rows(rows: list[dict], dims, pricing: Pricing,
               prompt_rows: list[dict] | None = None) -> list[dict]:
    """Group rows by one or more dimensions; attach cost + stats metrics."""
    def keyfn(r):
        return tuple(r[d] for d in dims)

    prompt_counts = {}
    if prompt_rows is not None:
        for p in prompt_rows:
            prompt_counts[keyfn(p)] = prompt_counts.get(keyfn(p), 0) + 1

    buckets = {}
    for r in rows:
        buckets.setdefault(keyfn(r), []).append(r)

    out = []
    for key, items in buckets.items():
        rec = dict(zip(dims, key))
        toks = [i["in"] + i["out"] + i["reason"] + i["cr"] + i["cw"] for i in items]
        rep = sum(i["cost"] for i in items)
        est = sum(pricing.estimate(i) for i in items)
        eff = sum(i["cost"] if i["cost"] > 0 else pricing.estimate(i) for i in items)
        in_sum = sum(i["in"] for i in items)
        cr_sum = sum(i["cr"] for i in items)
        cw_sum = sum(i["cw"] for i in items)
        out.append({
            **rec,
            "n": len(items),
            "prompts": prompt_counts.get(key, 0),
            "sessions": len({i["session"] for i in items}),
            "in": in_sum,
            "out": sum(i["out"] for i in items),
            "reason": sum(i["reason"] for i in items),
            "cr": cr_sum,
            "cw": cw_sum,
            "tok_total": sum(toks),
            "cost_rep": rep,
            "cost_est": est,
            "cost_eff": eff,
            "cache_ratio": (cr_sum / (cr_sum + in_sum + cw_sum)
                            if (cr_sum + in_sum) > 0 else 0.0),
            "tok_mean": statistics.fmean(toks) if toks else 0.0,
            "tok_median": statistics.median(toks) if toks else 0.0,
            "tok_p90": percentile(toks, 90),
            "first_ts": min(i["ts"] for i in items),
            "last_ts": max(i["ts"] for i in items),
        })
    return out


def percentile(values: list[float], p: float):
    if not values:
        return 0.0
    s = sorted(values)
    k = (len(s) - 1) * (p / 100)
    f, c = math.floor(k), math.ceil(k)
    if f == c:
        return s[int(k)]
    return s[f] * (c - k) + s[c] * (k - f)


SORT_KEYS = {
    "cost": lambda g: g["cost_eff"],
    "rep": lambda g: g["cost_rep"],
    "est": lambda g: g["cost_est"],
    "tokens": lambda g: g["tok_total"],
    "msgs": lambda g: g["n"],
    "sessions": lambda g: g["sessions"],
    "name": lambda g: 0,
    "date": lambda g: g["first_ts"],
    "date-desc": lambda g: g["first_ts"],
}


def sort_groups(groups: list[dict], by: str, dims):
    fn = SORT_KEYS.get(by)
    if fn is None:
        sys.exit(f"{PROG}: unknown --sort '{by}' "
                 f"(choose from: {', '.join(SORT_KEYS)})")
    if by in ("name", "date", "date-desc"):
        rev = by == "date-desc"
        return sorted(groups, key=lambda g: (fn(g), *[str(g[d]) for d in dims]),
                      reverse=rev)
    return sorted(groups, key=fn, reverse=True)



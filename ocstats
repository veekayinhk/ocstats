# pricing (models.dev + user overrides)
# ----------------------------------------------------------------------------

class Pricing:
    """Resolve per-model rates: overrides > models.dev (tier-aware)."""

    def __init__(self, refresh=False):
        self.doc = {}
        self.overrides = {}
        self.source_note = ""
        self._resolved = {}
        self._load_overrides()
        if refresh:
            self._fetch()
        elif CACHE_FILE.exists():
            try:
                self.doc = json.loads(CACHE_FILE.read_text())
            except (json.JSONDecodeError, OSError):
                pass
        else:
            self._fetch(quiet=True)

    def _load_overrides(self):
        if OVERRIDES_FILE.exists():
            try:
                self.overrides = json.loads(OVERRIDES_FILE.read_text())
            except (json.JSONDecodeError, OSError) as e:
                print(f"{PROG}: warning: bad overrides file {OVERRIDES_FILE}: {e}",
                      file=sys.stderr)

    def _fetch(self, quiet=False):
        try:
            req = urllib.request.Request(
                MODELS_DEV_URL, headers={"User-Agent": f"{PROG}/{VERSION}"})
            with urllib.request.urlopen(req, timeout=15) as resp:
                self.doc = json.loads(resp.read())
            CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
            CACHE_FILE.write_text(json.dumps(self.doc))
            return True
        except Exception as e:  # noqa: BLE001
            if not quiet:
                sys.exit(f"{PROG}: failed to fetch {MODELS_DEV_URL}: {e}")
            return False

    @property
    def available(self) -> bool:
        return bool(self.doc) or bool(self.overrides)

    def _candidates(self, provider: str, model: str):
        """Ordered (provider, model) lookup candidates for fuzzy matching."""
        base = model.split("@")[0]
        leaf = base.split("/")[-1]
        seen, cands = set(), []
        for p, m in ((provider, model), (provider, base), (provider, leaf),
                     ("*", model), ("*", base), ("*", leaf)):
            if m and (p, m) not in seen:
                seen.add((p, m))
                cands.append((p, m))
        return cands

    def rates(self, provider: str, model: str):
        """Return (rates dict in $/1M, source label)."""
        key = (provider, model)
        if key in self._resolved:
            return self._resolved[key]
        result = ({"input": 0.0, "output": 0.0, "cache_read": 0.0, "cache_write": 0.0},
                  "no data")
        for p, m in self._candidates(provider, model):
            if p != "*":
                ov = self.overrides.get(f"{p}/{m}")
                if ov is not None:
                    r = {"input": 0.0, "output": 0.0, "cache_read": 0.0, "cache_write": 0.0}
                    r.update({k: float(v) for k, v in ov.items()
                              if k in ("input", "output", "cache_read", "cache_write")})
                    result = (r, "override")
                    break
            mdev = self.doc.get(p if p != "*" else "", {}).get("models", {})
            if p != "*":
                entry = mdev.get(m)
                if entry is not None:
                    result = (self._base_rates(entry), "models.dev")
                    break
        if result[1] == "no data" and self.doc:
            # global fallback: exact then leaf across every provider
            for prov_id, prov in sorted(self.doc.items()):
                models = prov.get("models", {})
                if model in models:
                    result = (self._base_rates(models[model]), "models.dev~")
                    break
                if model.split("@")[0].split("/")[-1] in models:
                    result = (self._base_rates(models[model.split("@")[0].split("/")[-1]]),
                              "models.dev~")
                    break
        self._resolved[key] = result
        return result

    @staticmethod
    def _base_rates(entry: dict):
        cost = entry.get("cost") or {}
        return {k: float(cost.get(k) or 0.0)
                for k in ("input", "output", "cache_read", "cache_write")}

    def estimate(self, row: dict):
        """Estimated cost for one message, tier-aware. Returns float."""
        provider, model = row["provider"], row["model"]
        rates, _src = self.rates(provider, model)
        entry = None
        # tier lookup needs the raw entry; find it again cheaply
        doc = self.doc.get(provider, {}).get("models", {})
        entry = doc.get(model) or doc.get(model.split("@")[0]) \
            or doc.get(model.split("@")[0].split("/")[-1])
        if entry and entry.get("cost", {}).get("tiers"):
            context = row["in"] + row["cr"] + row["cw"]
            for tier in entry["cost"]["tiers"]:
                size = (tier.get("tier") or {}).get("size") or 0
                if size and context > size:
                    rates = {k: float(tier.get(k) if tier.get(k) is not None
                                      else rates[k])
                             for k in rates}
        return (row["in"] * rates["input"]
                + row["out"] * rates["output"]
                + row["cr"] * rates["cache_read"]
                + row["cw"] * rates["cache_write"]) / 1_000_000



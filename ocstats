    "tokens": ("Tokens", lambda g: g["tok_total"], "tok"),
    "in": ("Tok in", lambda g: g["in"], "tok"),
    "out": ("Tok out", lambda g: g["out"], "tok"),
    "cache": ("Cache hits", lambda g: g["cr"], "tok"),
    "msgs": ("Msgs", lambda g: g["n"], "tok"),

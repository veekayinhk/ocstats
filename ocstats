def cmd_pivot(rows, flt, pricing, args):
    """Cross-tab: --rows project --cols day --metric tokens."""
    rowdim, coldim = args.rows, args.cols
    if rowdim not in DIMENSIONS or coldim not in DIMENSIONS:
        sys.exit(f"{PROG}: --rows/--cols must be one of: {', '.join(DIMENSIONS)}")
    if rowdim == coldim:
        sys.exit(f"{PROG}: --rows and --cols must differ")
    if args.metric not in PIVOT_METRICS:
        sys.exit(f"{PROG}: --metric must be one of: {', '.join(PIVOT_METRICS)}")

    # auto-bucket wide day/week column ranges
    eff_coldim = coldim
    n_days = len({r[coldim] for r in rows})
    if coldim == "day" and n_days > 14:
        eff_coldim = "week"
        if len({r["week"] for r in rows}) > 14:
            eff_coldim = "month"
    elif coldim == "week" and n_days > 14:
        eff_coldim = "month"

    groups = group_rows(rows, [rowdim, eff_coldim], pricing,
                        getattr(args, "prompt_rows", None))
    label, metric_fn, fmt = PIVOT_METRICS[args.metric]

    col_keys = sorted({g[eff_coldim] for g in groups})
    row_keys = sorted({g[rowdim] for g in groups},
                      key=lambda rk: -sum(metric_fn(g) for g in groups
                                          if g[rowdim] == rk))
    row_totals = {rk: sum(metric_fn(g) for g in groups if g[rowdim] == rk)
                  for rk in row_keys}
    col_totals = {ck: sum(metric_fn(g) for g in groups if g[eff_coldim] == ck)
                  for ck in col_keys}
    grand = sum(col_totals.values())
    mx = max([metric_fn(g) for g in groups] + [0]) or 1

    cell = {(g[rowdim], g[eff_coldim]): metric_fn(g) for g in groups}

    def fmtv(v, heat=False):
        s = money(v) if fmt == "money" else tok(v)
        if heat and C.enabled and v > 0:
            q = v / mx
            if q >= 0.75:
                s = C.bold(C.white(s))
            elif q >= 0.5:
                s = C.white(s)
            elif q >= 0.25:
                s = C.green(s)
            else:
                s = C.dim(s)
        return s

    def collabel(ck):
        if eff_coldim in ("day", "week") and re.fullmatch(r"\d{4}-\d{2}-\d{2}", ck):
            return ck[5:]          # MM-DD
        if eff_coldim in ("day", "week") and re.fullmatch(r"\d{4}-\d{2}", ck):
            return ck[2:]          # YY-MM
        return ck

    if args.json:
        out = []
        for rk in row_keys:
            for ck in col_keys:
                v = cell.get((rk, ck), 0)
                if v:
                    out.append({rowdim: rk, eff_coldim: ck, "value": v,
                                "share": v / grand if grand else 0})
        print(json.dumps({"meta": meta_json(flt, pricing),
                          "rows": out,
                          "row_totals": row_totals, "col_totals": col_totals,
                          "grand_total": grand}, indent=2))
        return
    if args.csv:
        w = csv.writer(sys.stdout, lineterminator="\n")
        w.writerow([rowdim] + [collabel(ck) for ck in col_keys] + ["TOTAL"])
        for rk in row_keys:
            w.writerow([rk] + [cell.get((rk, ck), 0) for ck in col_keys]
                       + [row_totals[rk]])
        w.writerow(["TOTAL"] + [col_totals[ck] for ck in col_keys] + [grand])
        return

    print_hint_pricing(pricing)
    print()

    if MD_OUT:
        title = f"{label} — {rowdim} × {eff_coldim}"
        if eff_coldim != coldim:
            title += f" ({coldim} bucketed → {eff_coldim})"
        lines = [f"### {title}", ""]
        lines.append("| " + " | ".join([rowdim] +
                     [collabel(ck) for ck in col_keys] + ["TOTAL"]) + " |")
        lines.append("|" + "---|" * (len(col_keys) + 2))
        for rk in row_keys:
            lines.append("| " + " | ".join(
                [truncate(rk, 28)] +
                [fmtv(cell.get((rk, ck), 0)) for ck in col_keys] +
                [f"**{fmtv(row_totals[rk])}**"]) + " |")
        lines.append("| " + " | ".join(
            ["**TOTAL**"] + [f"**{fmtv(col_totals[ck])}**" for ck in col_keys] +
            [f"**{fmtv(grand)}**"]) + " |")
        print("\n".join(lines))
        print()
        return

    title = f"{label} · {rowdim} × {eff_coldim}"
    if eff_coldim != coldim:
        title += f"  {C.dim(f'({coldim} bucketed → {eff_coldim})')}"
    print(f"  {C.bold(C.cyan(title))}  {C.dim('· ' + flt.describe())}")

    # text grid via the boxed renderer
    headers = [rowdim.capitalize()] + [collabel(ck) for ck in col_keys] + ["Total"]
    aligns = "l" + "r" * (len(col_keys) + 1)
    trows, footer = [], None
    for rk in row_keys:
        trows.append([truncate(rk, 28)] +
                     [fmtv(cell.get((rk, ck), 0), heat=True) for ck in col_keys] +
                     [C.bold(fmtv(row_totals[rk]))])
    tbl = Table(width=max(term_width(args), 20 * (len(col_keys) + 2)))
    for i, h in enumerate(headers):
        tbl.col(h, "r" if i else "l", priority=10 if i == 0 else 5)
    for r in trows:
        tbl.add(*r)
    tbl.set_footer(*([C.bold("TOTAL")] +
                     [C.bold(fmtv(col_totals[ck])) for ck in col_keys] +
                     [C.bold(C.white(fmtv(grand)))]))
    tbl.note = (f"heat: dim <25% <50% <75% ≤max of {label.lower()} · "
                f"metric: {args.metric}")
    print(tbl.render())
    print()


